# 배포 도메인 (https 포함, 끝 슬래시 없음). canonical·hreflang·sitemap 생성에 사용됩니다.
VITE_SITE_URL=https://your-domain.example

# --- AdSense (심사 통과 후에만 켜세요) ---
# false: 광고 스크립트·슬롯 없음 (재심사·개발용). true: 아래 client·slot ID 필요.
VITE_ADSENSE_ENABLED=false
# 발행자 ID (ads.txt와 동일)
VITE_ADSENSE_CLIENT=ca-pub-7746919888868319
# AdSense → 광고 → 디스플레이 단위에서 생성한 data-ad-slot 값 (숫자만)
# 푸터(면책 nav 위) — 승인 직후 1개만 넣어도 수익 시작 가능
VITE_ADSENSE_SLOT_FOOTER=
# 연봉 탭 비교표 아래 (선택, 2~4주 후 추가 권장)
VITE_ADSENSE_SLOT_SALARY=
